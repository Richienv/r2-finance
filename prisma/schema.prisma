generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())

  expenses        Expense[]
  macros          Macro[]
  incomes         Income[]
  fixedCosts      FixedCost[]
  monthlySettings MonthlySettings[]
  dailyBudgets    DailyBudget[]
  activityLogs    ActivityLog[]
}

model Expense {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String   // YYYY-MM-DD CST
  amountRMB Float
  amountIDR Float
  category  String   // FOOD | PERSONAL | OTHER | FIXED
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, date])
  @@index([userId, category])
}

model MonthlySettings {
  id           String @id @default(cuid())
  userId       String?
  user         User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  month        String // YYYY-MM
  allowanceIDR Int
  allowanceRMB Float
  idrPerRmb    Float
  paydayDay    Int

  @@unique([userId, month])
}

model FixedCost {
  id         String  @id @default(cuid())
  userId     String?
  user       User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  amountRMB  Float
  billingDay Int?
  active     Boolean @default(true)

  @@index([userId])
}

model Income {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String   // YYYY-MM-DD CST
  amountRMB Float
  amountIDR Float
  source    String   // SALARY | BONUS | SIDE | OTHER
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, date])
  @@index([userId, source])
}

model DailyBudget {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         String   // YYYY-MM-DD CST
  baseAmount   Float    // always 37
  carryover    Float    // positive = bonus, negative = debt
  budgetAmount Float    // clamp(base + carryover, 10, 100)
  spent        Float    @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([userId, date])
}

model Macro {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String   // YYYY-MM-DD CST
  amountRMB Float
  amountIDR Float
  type      String   // INCOME | EXPENSE
  category  String   // see lib/macro.ts
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, date])
  @@index([userId, type])
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  actor      String
  action     String
  entityId   String?
  entityType String?
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}
