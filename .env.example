DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Cron auth for /api/cron/auto-log-fixed (Bearer)
CRON_SECRET="change-me"

# Hermes/Ren agent key — required on mutating /api endpoints
# (x-api-key or Authorization: Bearer). Maps to the owner account.
R2_FINANCE_API_KEY="change-me"

# Session signing secret for email/password auth (generate: openssl rand -base64 48)
AUTH_SECRET="change-me"

# The owner account's email. Agent + R2·OS endpoints operate on this user's
# data, and this account claims all pre-existing (pre-login) rows on first login.
OWNER_EMAIL="you@example.com"
